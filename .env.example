# Copy this file to .env and fill in the two required settings.

# REQUIRED — the public https:// address people (and Apple Podcasts) reach this app on.
APP_URL=https://podcasts.example.com

# REQUIRED — password for the web panel. At least 16 characters.
# Generate one with: openssl rand -base64 24
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Everything below is optional.

# Port the app listens on (default 3000).
# PORT=3000

# Where the database, audio and generated secrets live (default ./data).
# DATA_DIR=./data

# Text put in front of each show's title in your feeds (default "AF ").
# FEED_TITLE_PREFIX=AF 

# How many processed episodes to keep per show (default 15), how many recent
# episodes to process when you add a show (default 3), and how often to check
# feeds for new episodes (default 15 minutes).
# RETENTION_PER_SHOW=15
# BACKFILL_COUNT=3
# POLL_INTERVAL_MINUTES=15

# Sign in with your own identity provider (Pocket ID, Authentik, Keycloak,
# Google…) in addition to / instead of the password. Register a confidential
# client with PKCE and callback URL <APP_URL>/api/auth/callback.
# OIDC_NAME=Pocket ID
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# ALLOWED_EMAIL=you@example.com

# Normally generated automatically and stored in DATA_DIR/secrets.json.
# SESSION_SECRET=
# FEED_TOKEN=
